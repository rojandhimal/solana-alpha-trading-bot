NODE_ENV=development
APP_NAME=solana-alpha-bot
LOG_LEVEL=info
DATABASE_URL=postgresql://localhost:5432/alpha_bot
REDIS_URL=redis://localhost:6379

# Safe-by-default: live trading is disabled unless explicitly enabled.
LIVE_TRADING=false

# Prefer RPC_ENDPOINT; SOLANA_RPC_URL is supported for backwards compatibility.
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
DEXSCREENER_BASE_URL=https://api.dexscreener.com

SCAN_INTERVAL_MS=15000
MIN_LIQUIDITY_USD=100000
MIN_VOLUME_24H_USD=500000
MIN_PAIR_AGE_MINUTES=30
MAX_HOLDER_CONCENTRATION_PERCENT=30
MAX_EXPECTED_SLIPPAGE_PERCENT=1
MIN_SIGNAL_SCORE=80
TRADING_MODE=PAPER

# NEVER commit secrets. Set them via local environment variables or GitHub Secrets.
# PRIVATE_KEY=
# MNEMONIC=
# SOLANA_PRIVATE_KEY=

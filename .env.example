NODE_ENV=development
APP_NAME=solana-alpha-bot
LOG_LEVEL=info
DATABASE_URL=postgresql://alpha:alpha_password@localhost:5432/alpha_bot
REDIS_URL=redis://localhost:6379
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
DEXSCREENER_BASE_URL=https://api.dexscreener.com
SCAN_INTERVAL_MS=15000
MIN_LIQUIDITY_USD=100000
MIN_VOLUME_24H_USD=500000
MIN_PAIR_AGE_MINUTES=30
MAX_HOLDER_CONCENTRATION_PERCENT=30
MAX_EXPECTED_SLIPPAGE_PERCENT=1
MIN_SIGNAL_SCORE=80
TRADING_MODE=PAPER
SOLANA_PRIVATE_KEY=

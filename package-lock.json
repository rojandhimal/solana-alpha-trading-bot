    },
    "node_modules/vitest": {
      "version": "2.1.8",
      "dev": true
    },
    "node_modules/zod": {
      "version": "3.24.2"
    },
    "node_modules/@alpha/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@alpha/holders": {
      "resolved": "packages/holders",
      "link": true

    "node_modules/@alpha/liquidity": {
      "resolved": "packages/liquidity",
      "link": true
    },
    "node_modules/@alpha/logger": {
      "resolved": "packages/logger",
      "link": true
    },
    "node_modules/@alpha/market-data": {
      "resolved": "packages/market-data",
      "link": true
    },
    "node_modules/@alpha/onchain": {
      "resolved": "packages/onchain",
      "link": true
    },
    "node_modules/@alpha/scoring": {
      "resolved": "packages/scoring",
      "link": true
    },
    "node_modules/@alpha/solana": {
      "resolved": "packages/solana",
      "link": true
    },
    "node_modules/@alpha/token-safety": {
      "resolved": "packages/token-safety",
      "link": true

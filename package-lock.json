      }
    },
    "node_modules/@types/node": {
      "version": "22.10.0",
      "dev": true
    },
    "node_modules/dotenv": {
      "version": "17.4.2"
    },
    "node_modules/pino": {
      "version": "10.3.1"
    },
    "node_modules/prettier": {
      "version": "3.4.2",
      "dev": true

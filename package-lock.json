        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
      }
    },
    "packages/config": {
      "name": "@alpha/config",
      "version": "0.1.0"
    },
    "packages/holders": {
      "name": "@alpha/holders",
      "version": "0.1.0"
    },
    "packages/liquidity": {
      "name": "@alpha/liquidity",
      "version": "0.1.0"
    },
    "packages/logger": {
      "name": "@alpha/logger",
      "version": "0.1.0"
    },
    "packages/market-data": {
      "name": "@alpha/market-data",
      "version": "0.1.0"
